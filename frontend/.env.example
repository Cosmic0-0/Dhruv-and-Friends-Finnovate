# Backend origin that Next proxies /api/* to (server-side only, no trailing slash).
# The browser never calls this directly. Defaults to http://localhost:4000.
# For production builds this is baked in at `next build` time.
BACKEND_URL=http://localhost:4000
# Public origin of the deployed frontend, used for absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: comma-separated extra hosts allowed to load dev assets (e.g. your
# LAN IP, to test `next dev` from a phone).
ALLOWED_DEV_ORIGINS=
