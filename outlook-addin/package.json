{
  "name": "fraudlens-outlook-addin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "office-addin-manifest validate manifest.xml",
    "manifest:prod": "node scripts/render-manifest.mjs",
    "smoke:demo": "node scripts/smoke-fixtures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.609",
    "jsdom": "^29.1.1",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-manifest": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
