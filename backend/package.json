{
  "name": "fraudlens-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "test:fallback": "node --env-file-if-exists=.env scripts/check-llm-fallback.js",
    "test:ocr": "node scripts/check-ocr.js",
    "fixtures:documents": "node scripts/make-document-fixtures.js",
    "seed:wave": "node --env-file-if-exists=.env scripts/seed-wave-demo.js",
    "eval": "node --env-file-if-exists=.env scripts/eval.js",
    "eval:kreol": "node --env-file-if-exists=.env scripts/kreol-eval.js",
    "eval:kreol:translate": "node --env-file-if-exists=.env scripts/kreol-translate-eval.js",
    "update:threat-feed": "node scripts/update-threat-feed.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "fflate": "0.8.3",
    "helmet": "^8.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  }
}
