PORT=4000
DATABASE_URL=./fraudlens.db

# Local LLM (Ollama) — see README.md "Local LLM Setup". Locally this is
# http://localhost:11434; in production it's a teammate's GPU machine reached
# over Tailscale.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Hosted fallback for when Ollama is unreachable — stays inactive until
# FALLBACK_API_KEY is set. LLM_MODE: local | fallback | auto.
# FALLBACK_PROVIDER: anthropic | openai | openrouter
#   openrouter is a single key that can route to many underlying models — if
#   FALLBACK_PROVIDER=openrouter, set OPENROUTER_MODEL to pick which one.
#   Default is a free-tier model (liquid/lfm-2.5-2.6b:free), chosen by
#   testing several free OpenRouter models against npm run test:fallback:
#   larger free "reasoning" models (nemotron-3-super-120b, nemotron-3.5-
#   lightning) reliably blew past LLM_TIMEOUT_MS; this small/fast one passed
#   2 of 3 tries and only missed the budget once under rapid back-to-back
#   testing (no cooldown) — free-tier OpenRouter capacity is shared and
#   latency varies run to run, so this is not a guaranteed-fast option.
#   Swap to a paid model (or a different FALLBACK_PROVIDER) if free-tier
#   latency/rate limits prove unreliable in demo-like conditions — see
#   backend/README.md § 9, npm run test:fallback.
FALLBACK_PROVIDER=anthropic
FALLBACK_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
LLM_TIMEOUT_MS=15000
LLM_MODE=auto
