PORT=4000
DATABASE_URL=./fraudlens.db

# Exact HTTPS origins hosting the Outlook task pane, comma separated.
# Development defaults to https://localhost:3001 when this is empty and
# NODE_ENV is not production. Production permits no browser origin until set.
OUTLOOK_ADDIN_ORIGINS=

# Local LLM (Ollama) — see README.md "Local LLM Setup". Locally this is
# http://localhost:11434; in production it's a teammate's GPU machine reached
# over Tailscale.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Hosted fallback for when Ollama is unreachable — stays inactive until
# FALLBACK_API_KEY is set. LLM_MODE: local | fallback | auto.
# FALLBACK_PROVIDER: anthropic | openai | openrouter
#   openrouter is a single key that can route to many underlying models — if
#   FALLBACK_PROVIDER=openrouter, set OPENROUTER_MODEL to pick which one.
#   Default is a free-tier model (liquid/lfm-2.5-2.6b:free), chosen by
#   testing several free OpenRouter models against npm run test:fallback:
#   larger free "reasoning" models (nemotron-3-super-120b, nemotron-3.5-
#   lightning) reliably blew past LLM_TIMEOUT_MS; this small/fast one passed
#   2 of 3 tries and only missed the budget once under rapid back-to-back
#   testing (no cooldown) — free-tier OpenRouter capacity is shared and
#   latency varies run to run, so this is not a guaranteed-fast option.
#   Swap to a paid model (or a different FALLBACK_PROVIDER) if free-tier
#   latency/rate limits prove unreliable in demo-like conditions — see
#   backend/README.md § 9, npm run test:fallback.
#
#   RE-TESTED 2026-09-22, still unresolved: 5 live npm run test:fallback /
#   direct-API runs against the real analyze prompt took 19.5s, 27.4s,
#   38.8s, 43.8s, and one that didn't finish inside 35s (reasoning token
#   counts 323-1811 on the same prompt shape — this model has MANDATORY
#   reasoning, OpenRouter rejects `reasoning: {enabled: false}` for it).
#   LLM_TIMEOUT_MS raised 15000 -> 60000 to give real margin against what's
#   been observed, but that is NOT the same as this being reliable — treat
#   the free-tier fallback as a real open risk for the live demo, not a
#   solved problem, until either a faster/non-reasoning model is found or a
#   paid fallback is budgeted. Re-run npm run test:fallback close to demo day.
FALLBACK_PROVIDER=anthropic
FALLBACK_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
LLM_TIMEOUT_MS=60000
LLM_MODE=auto

# Community cluster/wave detection (src/services/community-signals).
# REPORTER_HASH_SECRET keys the HMAC that pseudonymises reporter IPs (raw IPs
# are never stored). Set a long random value in any shared deployment - if
# unset, a random per-process key is used and distinct-reporter counts reset
# on every restart. Retention: evidence events / audit rows older than these
# many days are deleted automatically.
REPORTER_HASH_SECRET=
COMMUNITY_EVENT_RETENTION_DAYS=90
COMMUNITY_AUDIT_RETENTION_DAYS=180

# Outlook organisation intelligence (src/services/org-intel): observations,
# indicators and analyst labels older than this many days are deleted
# automatically (on boot and every 6h).
ORG_RETENTION_DAYS=180

# Document forensics (POST /api/documents, services/document-forensics-
# client) - a separate local Python service (document-forensics/, see its
# own README), reached over HTTP the same way OLLAMA_URL is above. Start it
# with `./.venv/bin/python -m app.main` from document-forensics/; a down/
# not-yet-started service degrades POST /api/documents's forensics field to
# {"status": "unavailable"} rather than failing ingestion. Cold start (first
# call after the Python process starts) can be slow - PyTorch/transformers
# model load on top of whichever checks actually run - so the timeout is
# generous; see llmClient.js's LLM_TIMEOUT_MS comment for the same
# "real margin, not a guarantee" reasoning applied here.
DOCUMENT_FORENSICS_URL=http://127.0.0.1:8081
DOCUMENT_FORENSICS_TIMEOUT_MS=90000

# Site Security Report (POST /api/analyze-site, services/site-security).
# No per-site limit, cache or concurrency cap, and no time limit on fetching
# the target site by default (both removed at the product owner's request).
# Set SITE_SECURITY_TIMEOUT_MS to reinstate a fetch time limit.
#   SITE_SECURITY_TIMEOUT_MS=

# Optional: Google Safe Browsing Lookup API key for /api/check-url (REP-05).
# Leave empty to disable; lookups fail open (a timeout or quota error adds no signal).
SAFE_BROWSING_API_KEY=
