{
  "manifest_version": 3,
  "name": "FraudLens AI — Link Guard",
  "version": "0.4.0",
  "description": "Warns if this site's domain looks like a lookalike of a known Mauritius bank/telecom domain. Verified by the FraudLens AI backend.",
  "minimum_chrome_version": "102",
  "icons": {
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FraudLens AI",
    "default_icon": {
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "permissions": ["tabs", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.fraudlens.site/*"]
}
